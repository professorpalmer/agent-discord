# Local Discord OS bootstrap (copy to .env and fill in).
# Never commit real tokens.

# Discord Bot token from the Bot tab (Reset Token). Shape: xxx.yyy.zzz
# Application client ID and OAuth client secret are NOT DISCORD_BOT_TOKEN.
# Never write those to DISCORD_BOT_TOKEN or ~/.pmharness/.discord_token.
# Leave empty to inherit ~/.pmharness/.discord_token on this host (never commit that file).
DISCORD_BOT_TOKEN=

# Discord transport: rest (default) | saseq | braindao
# rest = official Discord HTTP API. No Docker MCP. No Gateway.
# saseq / braindao are optional MCP adapters if you already run those servers.
DISCORD_MCP_PROVIDER=rest

# Transport: http | stdio
DISCORD_MCP_TRANSPORT=http

# SaseQ/discord-mcp HTTP convention (when transport=http + provider=saseq)
# Verified upstream default: http://127.0.0.1:8085/mcp
SASEQ_MCP_HTTP_URL=http://127.0.0.1:8085/mcp

# BrainDAO/@iqai/mcp-discord HTTP (when transport=http + provider=braindao)
BRAINDAO_MCP_HTTP_URL=http://127.0.0.1:3000/mcp

# Stdio command — REQUIRED when DISCORD_MCP_TRANSPORT=stdio.
# There is no fabricated default npm package for SaseQ.
# Example BrainDAO: npx -y @iqai/mcp-discord
# Example SaseQ: set whatever command your upstream install documents (often Docker/HTTP instead).
DISCORD_MCP_STDIO_COMMAND=

# Workspace root for SQLite + artifacts (default: ./.agent-discord)
AGENT_DISCORD_WORKSPACE=.agent-discord

# Max Discord object size in bytes (default 10 MiB). Not an unlimited S3 quota.
DISCORD_MAX_OBJECT_BYTES=10485760

# Compute mode: auto | cursor | agentic (default auto).
# auto uses agentic when an OpenRouter key is in the env or workspace vault;
# otherwise the existing Cursor pin path is used.
AGENT_DISCORD_COMPUTE=auto

# Optional host-key inherit for agentic compute. Leave empty here.
# Never commit a real key. Prefer `discord-os connect --from-env`.
OPENROUTER_API_KEY=

# Puppetmaster model pin — required when compute resolves to cursor.
# Canonical Cursor model id used in receipts/audit; CLI adapter model is grok-4.5.
# Allowlist is exact-match only (no silent fallback).
# Agentic compute uses openrouter/auto and does not require this pin.
PUPPETMASTER_MODEL=cursor/grok-4-5

# Optional: path to puppetmaster CLI if not on PATH
PUPPETMASTER_CLI=puppetmaster

# Optional: working directory passed to `puppetmaster cursor --cwd`
# Defaults to the current working directory when unset.
PUPPETMASTER_CWD=

# Backend selector: puppetmaster (default) | marionette (explicit opt-in).
# Marionette never replaces Puppetmaster silently — set this only when you have
# a reachable Marionette HTTP API. Model pin remains cursor/grok-4-5 → grok-4.5.
AGENT_DISCORD_BACKEND=puppetmaster

# Marionette HTTP API (required when AGENT_DISCORD_BACKEND=marionette).
# Paths are configurable; this repo does not claim an unverified upstream shape.
MARIONETTE_BASE_URL=
MARIONETTE_SESSIONS_PATH=/v1/sessions
MARIONETTE_JOBS_PATH=/v1/jobs
MARIONETTE_API_TOKEN=

# Host surfaces on the listen machine (Terminal, file manager, browser).
# Discord is the remote. Default on. Paths stay under PUPPETMASTER_CWD + workspace.
# Leave-running: `discord-os setup --channel-id ID` then press On / Off on the HOST card.
AGENT_DISCORD_HOST_ACTIONS=on

# Numeric application client id (Developer Portal → General Information → Application ID).
# Used by `discord-os invite`. Not DISCORD_BOT_TOKEN.
DISCORD_APPLICATION_ID=

# Slash / Interactions HTTP engine. Default off.
# Poverty path is message-prefix: /open terminal|files|browser and /connect.
# Opt-in: AGENT_DISCORD_INTERACTIONS=http, then `discord-os interactions --serve`
# and paste YOUR public HTTPS URL into Developer Portal → Interactions Endpoint URL.
# Do not paste a tunnel URL into chat. Slash /connect never accepts a secret option.
# Do not advertise slash as required.
AGENT_DISCORD_INTERACTIONS=off
DISCORD_PUBLIC_KEY=
DISCORD_INTERACTIONS_HOST=127.0.0.1
DISCORD_INTERACTIONS_PORT=8743
